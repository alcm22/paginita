generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  username     String   @unique
  avatarUrl    String?
  bio          String?  @db.VarChar(280)
  allowMessagesFrom String   @default("EVERYONE") // "EVERYONE" | "FRIENDS"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendshipsAsUserA     Friendship[]    @relation("FriendshipUserA")
  friendshipsAsUserB     Friendship[]    @relation("FriendshipUserB")
  posts                  Post[]
  likes                  PostLike[]
  comments               Comment[]
  commentReplies         CommentReply[]
  notifications          Notification[]  @relation("ReceivedNotifications")
  triggeredNotifications Notification[]  @relation("TriggeredNotifications")
  conversationsAsUserA   Conversation[]  @relation("ConversationUserA")
  conversationsAsUserB   Conversation[]  @relation("ConversationUserB")
  sentMessages           Message[]       @relation("SentMessages")
}

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model Friendship {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
}

model Post {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(5000)
  imageUrl     String?
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes         PostLike[]
  comments      Comment[]
  notifications Notification[]

  @@index([authorId, createdAt])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(2000)
  authorId  String
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post    Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  replies CommentReply[]

  @@index([postId, createdAt])
  @@index([authorId])
}

model CommentReply {
  id        String   @id @default(cuid())
  content   String   @db.VarChar(2000)
  authorId  String
  commentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId, createdAt])
  @@index([authorId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String
  type      String   // "FRIEND_REQUEST", "LIKE", "COMMENT", "REPLY"
  read      Boolean  @default(false)
  postId    String?
  createdAt DateTime @default(now())

  user  User  @relation("ReceivedNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User  @relation("TriggeredNotifications", fields: [actorId], references: [id], onDelete: Cascade)
  post  Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Conversation {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  content        String   @db.VarChar(2000)
  conversationId String
  senderId       String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}