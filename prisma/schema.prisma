generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  username     String   @unique
  avatarUrl    String?
  bio          String?  @db.VarChar(280)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
